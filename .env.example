LEADERBOARD_ENVIRONMENT=development
LEADERBOARD_REDIS_URL=redis://localhost:6379/0
LEADERBOARD_REDIS_KEY_PREFIX=leaderboard
LEADERBOARD_REDIS_SOCKET_TIMEOUT=2.0
LEADERBOARD_REDIS_CONNECT_TIMEOUT=2.0

# Required: generate your own random 32-256 character ASCII key (see README).
# LEADERBOARD_SUBMISSION_API_KEY=

# Optional separate monitoring credential; unset/empty disables /metrics (404).
# LEADERBOARD_METRICS_API_KEY=
